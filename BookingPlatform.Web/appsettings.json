{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=booking_platform;Username=postgres;Password=1234"
  },
  "Jwt": {
    "Issuer": "BookingPlatform",
    "Audience": "BookingPlatform",
    "Secret": "change_this_dev_secret_key_please",
    "AccessTokenLifetimeMinutes": 60,
    "RefreshTokenLifetimeDays": 7
  },
  "BookingLifecycleJob": {
    "IntervalSeconds": 10,
    "ConfirmationWindowMinutes": 15,
    "NoShowGraceMinutes": 1,
    "AutoStartEnabled": true,
    "AutoCompleteEnabled": true
  },
  "RiskPolicy": {
    "ConfirmationThreshold": 0.5,
    "ConfirmationWindowMinutes": 15
  },
  "Planner": {
    "WorkingDayStartHourUtc": 8,
    "WorkingDayEndHourUtc": 20,
    "SlotStepMinutes": 30,
    "MaxCandidatePool": 30
  },
  "Ollama": {
    "BaseUrl": "http://localhost:11434",
    "Model": "llama3",
    "TimeoutSeconds": 5
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
