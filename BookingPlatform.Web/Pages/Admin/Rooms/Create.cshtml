@page
@model BookingPlatform.Web.Pages.Admin.Rooms.CreateModel
@{
    ViewData["Title"] = "Create room";
}

<h1>Create room</h1>

<p>
    <a asp-page="/Admin/Rooms/Index">Back to rooms</a> |
    <a asp-page="/Admin/Index">Back to admin panel</a>
</p>

<form method="post">
    <div class="form-group">
        <label asp-for="BuildingId"></label>
        <select asp-for="BuildingId" class="form-control">
            <option value="">-- select building --</option>
            @foreach (var b in Model.Buildings)
            {
                <option value="@b.Id">@b.Name (@b.Code)</option>
            }
        </select>
        <span asp-validation-for="BuildingId" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Number"></label>
        <input asp-for="Number" class="form-control" />
        <span asp-validation-for="Number" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Floor"></label>
        <input asp-for="Floor" class="form-control" />
        <span asp-validation-for="Floor" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Capacity"></label>
        <input asp-for="Capacity" class="form-control" />
        <span asp-validation-for="Capacity" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="RoomTypeId"></label>
        <select asp-for="RoomTypeId" class="form-control">
            <option value="">-- select room type --</option>
            @foreach (var t in Model.RoomTypes)
            {
                <option value="@t.Id">@t.Name (@t.Code)</option>
            }
        </select>
        <span asp-validation-for="RoomTypeId" class="text-danger"></span>
    </div>
    <div class="form-group form-check">
        <input asp-for="IsActive" class="form-check-input" />
        <label asp-for="IsActive" class="form-check-label"></label>
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
</form>
